   "strafe_mult": 0.6,
   "steer_every": 2,
   "m_per_tile": 2.0,
   "gravity": 9.8,
   "drift_per_100m": 0.8,
   "view_base": 4.0,
   "view_per_m": 0.08,
   "mark_every": 10,
   "mark_ticks": 60,
   "spot_base": 0.5,
   "noise_base": 0.04,
   "noise_range": 0.6,
   "jam_noise": 0.45,
   "jam_margin": 4.0,
   "link_range": 36.0,
   "air_link_range": 120.0,
   "battery_s": 240,
   "return_at": 0.2,
   "recover_radius": 1.0,
