      "breach": {"check_every_s": 2.0, "hostile_min": 4, "hold_s": 10.0, "_tuned": "LPMODE7-3: ground units only (aircraft overhead never hold a ring); 3 for 6 s let the first stray group take a ring in the natural soak", "economy_income_mult": 0.5, "creep_seed": true},
      "outside": {"check_every_s": 2.0, "creep_dps": 1.5, "pack_after_s": 45.0, "pack_min_units": 3, "pack_defs": ["g7_m_packhunter", "m_stalker_synth"], "pack_size": 4, "pack_cooldown_s": 90.0},
