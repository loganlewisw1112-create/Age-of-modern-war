 "rules": {
  "g7_cn": {
   "_note": "CNSIM7 (G7 master scope 6.3-6.8). Every number PROVISIONAL.",
   "research": "g7_counter_nanite",
   "tac_cap": 3,
   "loadout_leash": 12,
   "facility_defs": [
    "g7_cn_facility",
    "g7_cn_garage",
    "g7_cn_decon",
    "g7_cn_gate",
    "g7_cn_helipad"
   ],
   "decon_defs": [
    "g7_cn_decon"
   ],
   "decon_radius": 2.5,
   "team_names": [
    "Halcyon",
    "Warden",
    "Lantern",
    "Bastion",
    "Aegis",
    "Sentinel",
    "Vigil",
    "Ember"
   ],
   "op_names": [
    "Reaper",
    "Viper",
    "Ghost",
    "Raven",
    "Talon",
    "Saber"
   ],
   "packages": {
    "purge": {
     "size": 1,
     "arm_s": 20,
     "radius": 6
    },
    "seed_hunter": {
     "size": 1,
     "arm_s": 25,
     "radius": 11
    },
    "barrier": {
     "size": 1,
     "arm_s": 15,
     "radius": 5
    },
    "core_breaker": {
     "size": 2,
     "arm_s": 60,
     "radius": 3
    }
   },
   "default_loadout": [
    "purge",
    "purge",
    "seed_hunter",
    "barrier"
   ],
   "deploy": {
    "site_radius": 7,
    "scan_s": 6,
    "jam_s": 4,
    "think_every": 5,
    "jam_radius": 9,
    "jam_hold_s": 60,
    "need_dome": true
   },
   "hero": {
    "window_s": 6,
    "blast_radius": 3.5,
    "blast_damage": 600
   },
   "hold": {
    "sentries": 2,
    "barriers": 4,
    "ring": 3.5
   },
   "exposure": {
    "every": 10,
    "creep_rate": 0.02,
    "punct_rate": 0.03,
    "hurt_at": 0.25,
    "hurt_hp": 2,
    "slow_per": 0.5,
    "slow_min": 0.5,
    "max": 1
   },
   "kit": {
    "every": 10,
    "emp_grenade": {
     "radius": 2.5,
     "ticks": 100,
     "range": 5,
     "cooldown_s": 30
    }
   },
   "gunner": {
    "hit_chance": 0.25
   },
   "pair_leash": 8,
   "launcher": {
    "_note": "Owner amendment 2026-10-26: pop-out 6-tube micro rocket launcher on every CN APC, top rear right behind the gunner pod. Up to 6 canister types. All numbers PROVISIONAL.",
    "tubes": 6,
    "range": 9.0,
    "min_range": 1.5,
    "pop_s": 1.5,
    "stow_s": 6,
    "salvo": 1,
    "salvo_gap_s": 2.0,
    "reload_s": 16,
    "accuracy": 0.85,
    "think": 5,
    "auto_targets": "heavy",
    "firing_show_s": 0.6,
    "capacity": 49,
    "default_load": {
     "tandem": 28,
     "emp": 5,
     "thermite": 5,
     "he_frag": 3,
     "disruptor": 5,
     "smoke": 3
    },
    "kinds": {
     "tandem": {
      "cls": "at",
      "damage": 15,
      "stagger": 0.5
     },
     "emp": {
      "cls": "at",
      "damage": 3,
      "stun_s": 1.5,
      "stagger": 0.2
     },
     "thermite": {
      "cls": "at",
      "damage": 5,
      "burn_dps": 3,
      "burn_s": 6,
      "stagger": 0.15
     },
     "he_frag": {
      "cls": "autocannon",
      "damage": 30,
      "radius": 2.0,
      "stagger": 0.05
     },
     "disruptor": {
      "cls": "at",
      "damage": 5,
      "mark_s": 10,
      "mark_mult": 1.15,
      "sensors": 10,
      "stagger": 0.1
     },
     "smoke": {
      "smoke_s": 12
     }
    }
   },
   "heavy": {
    "_note": "Heavy Machine walkers: front armour, pincer bonus, stun/mark windows, topple. PROVISIONAL.",
    "defs": [
     "m_walker",
     "m_colossus"
    ],
    "min_hp": 900,
    "walk_classes": [
     "foot",
     "walker",
     "legged"
    ],
    "front_mult": 0.1,
    "flank_fixed_mult": 1.4,
    "rear_fixed_mult": 1.6,
    "stun_mult": 1.2,
    "down_mult": 1.1,
    "fix_range": 7.0,
    "direct_mult": 0.3,
    "sensors_floor": 75,
    "dome_mult": 4.0,
    "emp_scale": 0.3,
    "emp_immune_s": 10.0,
    "agility_speed_ref": 1.2,
    "agility_exp": 1.25,
    "agility_min": 0.45,
    "_note_agility": "CNSIM7-5: agility_* = launcher rounds and CN direct fire land less often on a fast-striding heavy walker: hit x max((agility_speed_ref / def speed) ^ agility_exp, agility_min); 1.0 at or below the ref speed and while toppled. PROVISIONAL."
   },
   "topple": {
    "_note": "Owner addition 2026-10-26: flank/rear leg hits while fixed frontally build stagger; past the threshold the walker topples (cannot move or fire), hits do heavy bonus damage; it rights itself and resets if not killed. PROVISIONAL.",
    "threshold": 26.0,
    "threshold_hp_ref": 950,
    "threshold_max": 26.0,
    "front_gain": 0.1,
    "unfixed_gain": 0.35,
    "side_gain": 1.0,
    "rear_gain": 1.3,
    "stun_gain": 1.5,
    "decay_per_s": 0.4,
    "decay_after_s": 8.0,
    "fall_s": 1.0,
    "down_s": 3.0,
    "rise_s": 2.0,
    "immune_s": 8.0,
    "down_exp": 0.75,
    "down_s_max": 9.0,
    "_note_down": "CNSIM7-5: down_s x (hp / threshold_hp_ref) ^ down_exp, max down_s_max: a heavier machine lies down longer. PROVISIONAL."
   },
   "pincer": {
    "_note": "Anti-walker pincer (owner addition 2026-10-26): one element rushes head-on to fix the walker, the rest take flank/rear slots and fire synchronised volleys. PROVISIONAL.",
    "detect": 12.0,
    "fix_dist": 4.0,
    "flank_dist": 6.0,
    "slot_angles": [
     110,
     -110,
     150,
     -150,
     180,
     80,
     -80
    ],
    "volley_s": 7.0,
    "reslot_s": 2.0,
    "reslot_drift": 2.0,
    "fixer_swap_hp": 0.3,
    "break_hp": 0.35,
    "think": 5,
    "head_on_angles": [
     25,
     -25,
     40,
     -40,
     0,
     15,
     -15
    ],
    "stall_s": 75.0,
    "stall_exp": 0.5,
    "stall_hp": 0.62,
    "_note_stall": "CNSIM7-5: stall_s x (hp / topple.threshold_hp_ref) ^ stall_exp into an engagement, a walker still above stall_hp (not lying down) means the attack has stalled: the group breaks contact. PROVISIONAL."
   },
   "ops_engage": {
    "_note": "Operators (and strike gunners on a downed walker) dismount and fight armour with their kit, then remount. PROVISIONAL.",
    "range": 10.0,
    "limpet": {
     "damage": 5,
     "cls": "at",
     "fuse_s": 3.0,
     "reach": 1.6,
     "cooldown_s": 20,
     "stagger": 1.8,
     "carry": {
      "hunter": 1,
      "gunner": 1
     },
     "stomp_chance": 0.3,
     "stomp_dmg": 110
    },
    "harpoon": {
     "range": 5.0,
     "cooldown_s": 18,
     "slow": 0.5,
     "slow_s": 6,
     "stagger": 1.0,
     "damage": 2.0
    },
    "disruptor": {
     "range": 11.0,
     "cooldown_s": 12,
     "damage": 4,
     "sensors": 10,
     "mark_s": 10,
     "stagger": 0.2
    },
    "gunner_limpet_r": 6.0,
    "gunners_per_apc": 1
   },
   "withdraw": {
    "_note": "Formed withdrawal (hero window, break contact): APC line facing the threat, soldiers in a block on the sheltered side, smoke on the threat side. PROVISIONAL.",
    "apc_gap": 2.5,
    "cols": 5,
    "col_gap": 1.0,
    "row_gap": 0.9,
    "apc_back": 2.5,
    "foot_back": 1.6,
    "break_dist": 12.0,
    "break_s": 30
   }
  }
 }
}
