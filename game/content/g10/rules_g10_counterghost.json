{
  "_meta": "G10 Human A Counter-Ghost Corps (CG10 Task 17). Numbers PROVISIONAL. Weaker than Coalition Death. No CN/Blackglass. Owner addendum seq 171.",
  "rules": {
    "g10_counterghost": {
      "faction": "human_a",
      "stage_min": 10,
      "weaker_than": "death",
      "no_coalition_production": true,
      "no_cn": true,
      "no_blackglass": true,
      "loadouts": {
        "interceptor": {
          "job": "chase_cut_extract",
          "camo": 0.35,
          "armor": 0.55,
          "power": 0.6,
          "def": "a_cg_intercept"
        },
        "bulwark": {
          "job": "hard_escort_hold",
          "camo": 0.2,
          "armor": 0.75,
          "power": 0.55,
          "def": "a_cg_breach"
        },
        "seeker": {
          "job": "find_shimmer_mark_net",
          "camo": 0.4,
          "armor": 0.45,
          "power": 0.65,
          "def": "a_cg_recon"
        },
        "ward": {
          "job": "vip_bodyguard",
          "camo": 0.25,
          "armor": 0.7,
          "power": 0.5,
          "def": "a_cg_ward_prime",
          "peel_on_hunt": false
        }
      },
      "death_baseline": {
        "camo": 0.9,
        "armor": 1.0,
        "power": 1.0
      },
