{
  "_meta": "G10 Ghost Exo Programme rules (GHOST10 Tasks 14-15). Numbers PROVISIONAL.",
  "rules": {
    "g10_ghost": {
      "faction": "shadow_coalition",
      "formations": {
        "4op": {"size": 4, "roles": ["leader", "point", "gunner", "specialist"]},
        "6op": {"size": 6, "roles": ["leader", "point", "gunner", "specialist", "support", "trail"]},
        "solo": {"size": 1, "roles": ["leader"]},
        "pair": {"size": 2, "roles": ["leader", "point"]}
      },
      "packages": {
        "strike": {"armor": "medium", "battery_mult": 1.0, "noise": 1.0},
        "assault": {"armor": "heavy", "battery_mult": 0.85, "noise": 1.25},
        "recon": {"armor": "light", "battery_mult": 1.2, "noise": 0.7}
      },
      "echelons": {
        "death": {"combat_tip": true, "intel_min": "pattern"},
        "shadow": {"combat_tip": false, "intel_min": "rumour"},
        "anchor": {"combat_tip": false, "intel_min": "rumour"}
      },
      "role_cards": ["blade", "glass", "anvil", "hook", "spark", "thread", "torch", "mirror"],
      "certs": ["sniper", "ew", "snatch", "combat_engineer", "combat_medic", "drone_controller", "anti_armour", "infiltrator", "pathfinder", "decoy_runner", "counter_ghost", "vault_breacher"],
      "camo": {
        "still": 0.02,
        "walk": 0.08,
        "sprint": 0.55,
        "fire": 0.7,
        "hit": 0.85,
        "battery_max": 100.0,
        "drain_still": 0.02,
        "drain_walk": 0.08,
        "drain_sprint": 0.35,
        "drain_fire": 0.5,
        "drain_hit": 0.2,
        "recharge_per_tick": 0.15,
        "empty_visibility": 0.95
      },
      "counters": {
        "thermal": 0.55,
        "sensor": 0.45,
        "dog": 0.7,
        "drone": 0.4,
        "rain": 0.25,
        "smoke": 0.2,
        "nanite_sense": 0.65
      },
      "intel_grades": ["rumour", "pattern", "fix", "keyhole"],
      "death_intel_min": "pattern",
      "templates": {
        "QuietDecap": {"need": "officer", "death": true, "shadow": false, "anchor": true, "package": "strike"},
        "SensorBlind": {"need": "sensor", "death": true, "shadow": true, "anchor": false, "package": "recon"},
        "WorkshopStrike": {"need": "workshop", "death": true, "shadow": false, "anchor": true, "package": "assault"},
        "FeintStorm": {"need": "feint", "death": true, "shadow": true, "anchor": true, "package": "strike"}
      },
      "phases": ["tasking", "intel_gate", "package", "rehearsal", "insertion", "approach", "action", "complication", "exfil", "hot_wash", "echo"],
      "ticks_per_phase": 2,
      "max_suit_loss": 2,
      "risk_budget": 3,
      "break_contact_default": true,
      "mk_bands": {
        "1": {"stage_min": 6, "stage_max": 8},
        "2": {"stage_min": 9, "stage_max": 10},
        "3": {"stage_min": 11, "stage_max": 13}
      },
      "chassis": {
        "hardpoints": 3,
        "hardpoint_kinds": ["sensor", "breach", "net", "emp"],
        "blood_debt": 5,
        "hardened_joints": true,
        "redundant_battery": true
      },
      "roles_special": {
        "judge": {"id": 56, "fragile": true},
        "warden": {"id": 57, "corridor": true},
        "shade": {"id": 58, "no_heavy": true},
        "sergeant": {"id": 59, "juniors": 3}
      },
      "ui_condition": ["fresh", "worn", "grounded"],
      "vehicles": {
        "insert_methods": {
          "foot": {"terrains": ["ground"], "stage_min": 7, "def": "", "exfil": true},
          "silent_rotor": {"terrains": ["air", "ground"], "stage_min": 7, "def": "x_silent_rotor", "exfil": true},
          "ghost_runner": {"terrains": ["ground"], "stage_min": 9, "def": "x_ghost_runner", "exfil": true},
          "mole": {"terrains": ["tunnel"], "stage_min": 8, "def": "x_mole", "mission_asset": true, "exfil": true},
          "stealth_apc": {"terrains": ["ground"], "stage_min": 7, "def": "x_stealth_apc", "exfil": true},
          "drop_pod": {"terrains": ["air", "ground"], "stage_min": 9, "def": "x_drop_pod", "mission_asset": true, "exfil": false},
          "river_ghost": {"terrains": ["wet"], "stage_min": 8, "def": "x_river_ghost", "exfil": true},
          "stealth_transport": {"terrains": ["air"], "stage_min": 8, "def": "x_stealth_transport", "exfil": true},
          "mini_sub": {"terrains": ["wet"], "stage_min": 9, "def": "x_mini_sub", "exfil": true},
          "exo_mule": {"terrains": ["ground"], "stage_min": 9, "def": "x_exo_mule", "exfil": false},
          "recovery_truck": {"terrains": ["ground"], "stage_min": 7, "def": "x_recovery_truck", "exfil": true},
          "drone_carrier": {"terrains": ["ground"], "stage_min": 9, "def": "x_ghost_drone_carrier", "exfil": false}
        },
        "silent_rotor": {
          "modes": ["quiet", "gunship"],
          "flip_one_way": true,
          "quiet_signature": 0.08,
          "gunship_signature": 0.92,
          "warning": "weapons_open_high_signature",
          "counter": "aa_and_sensor"
        },
        "mole": {
          "uses": "tunnels10",
          "not_machine_burrower": true,
          "primary_exit": true,
          "alternate_exit": true,
          "collapse_behind": true,
          "collapse_warning": "tunnel_collapse_readable"
        },
        "runner": {
          "tether_range": 12,
          "link_loss_ticks": 8,
          "remote_driver": true,
          "recovery_on_loss": true
        },
        "guardian_mule": {
          "postures": ["supply", "guardian", "overcharge"],
          "overcharge_requires": ["squad_loss", "abandonment"],
          "overcharge_delay_ticks": 6,
          "destroys_suit_cores": true,
          "not_area_bomb": true,
          "warning": "denial_overcharge_armed"
        },
        "anchor": {
          "supply_priority": true,
          "recovery_priority": true,
          "workshop_queue": true,
          "intact_suit_race": true
        },
        "drones": {
          "door_kick": {"id": 9, "actions": ["clear", "mark"]},
          "wiretap": {"id": 10, "actions": ["relay_perch", "bounded_tap"], "bounded": true},
          "spider": {"id": 37, "actions": ["wall", "ceiling", "hatch", "limpet", "power"]},
          "reaper": {"id": 38, "actions": ["loiter", "designate"], "rotorless": true},
          "magazines": {"id": 40, "kinds": ["recon", "emp", "backdoor", "thermite"], "pad_only": true},
          "nest": {"id": 41, "actions": ["repair", "replenish"], "destroyable": true}
        },
        "kits": {
          "breach_charges": {"id": 20, "kinds": ["soft", "hard", "collapse"]},
          "emp_scalpel": {"id": 21, "strong_vs": ["machine"], "weak_vs": ["human_a", "human_b"], "narrow": true},
          "backdoor_spike": {"id": 22, "requires_provenance": "syndicate_compromised", "not_universal": true}
        },
        "support_modules": ["cache_beetle", "false_convoy", "cryo_litter", "relay_mast_trailer", "wet_gate"]
      }
    }
  }
}
