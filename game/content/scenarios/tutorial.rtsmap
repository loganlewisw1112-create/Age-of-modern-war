	"triggers": [
		{
			"id": "step_move",
			"name": "step_move",
			"once": true,
			"prompt": "MOVE: select your Recon scout (left-click) and right-click inside the yellow flag area.",
			"step": 1,
			"then": [
				{
					"slot": 0,
					"text": "Good. Units go where you right-click.",
					"type": "message"
				}
			],
			"when": [
