			]
		},
		{
			"id": "step_gather",
			"name": "step_gather",
			"once": true,
			"prompt": "GATHER: select an Engineer and right-click the salvage pile. Bring back 50 salvage.",
			"step": 2,
			"then": [
				{
					"slot": 0,
					"text": "Salvage is coming in.",
					"type": "message"
				}
