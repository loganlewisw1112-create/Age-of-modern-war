  "calm_veteran": {
   "under_fire": ["Taking fire. Stay low, keep moving.", "Contact. Steady now, find cover."],
   "wounded": ["I'm hit. Still in it.", "Took one. I can keep going."],
   "kill": ["Target down.", "One less."],
   "hero": ["Setting the charge. Get clear. Go!", "This ends here. Charge is live."],
   "buddy_wounded": ["Man down. I've got him.", "Hold on, I'm coming to you."],
   "buddy_down": ["We lost one. Keep your heads.", "He's gone. Eyes up, finish the job."],
   "level": ["Team's sharper now. Good work.", "We're learning. Keep it up."]
  },
  "nervous_rookie": {
   "under_fire": ["They're shooting at us! Where's it coming from?", "Contact, contact! I'm pinned!"],
   "wounded": ["I'm hit! I'm hit!", "Medic! I need a medic!"],
   "kill": ["Got one! I think I got one!", "Is it down? It's down!"],
   "hero": ["I'm doing it! Get back, get back!", "Charge is live! Run!"],
   "buddy_wounded": ["They hit him! Somebody help!", "Man down! What do I do?"],
   "buddy_down": ["No, no, no. He's not moving!", "We lost him. We lost him!"],
   "level": ["Huh. Guess we're getting good at this.", "Did we just level up?"]
  },
  "joker": {
   "under_fire": ["Well. They've noticed us.", "Rude. Returning the favour."],
   "wounded": ["Ow. That's going in my file.", "Just a scratch. A big one."],
   "kill": ["And stay down.", "Scrap metal. You're welcome."],
   "hero": ["Always wanted a big exit.", "Smile for the camera, tin can!"],
   "buddy_wounded": ["Hey. No dying on my watch.", "Hang in there, you still owe me money."],
   "buddy_down": ["Not funny. Not funny at all.", "Damn it. Damn it."],
   "level": ["Promotion party's on me.", "Look at us. Professionals."]
  },
  "hardliner": {
   "under_fire": ["Contact! Return fire, now!", "Push through it. Suppress them!"],
   "wounded": ["Hit. Doesn't matter. Keep pushing.", "Wounded. Still fighting."],
   "kill": ["Kill confirmed.", "Next."],
   "hero": ["For the line. Detonating.", "No retreat. Charge is set."],
   "buddy_wounded": ["Drag him to cover. Move!", "Wounded man! Cover him!"],
   "buddy_down": ["They'll pay for that.", "Operator down. Mark it and move."],
   "level": ["We're getting harder. Good.", "Better. Not good enough yet."]
